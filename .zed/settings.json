// Project settings for Zed. Swift support (sourcekit-lsp) comes from the Swift extension and reads Package.swift.
{
  "languages": {
    "Swift": {
      "tab_size": 4,
      "preferred_line_length": 160,
      // swift-format runs through `make format`, so nobody's save reformats a whole file by surprise.
      "format_on_save": "off"
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store",
    "**/.build",
    "build",
    "vendor/engine/Chromium Framework.framework",
    "vendor/ublock"
  ]
}
