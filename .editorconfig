root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_style = space
indent_size = 4
max_line_length = 160

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.plist]
indent_style = tab
